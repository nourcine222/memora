# Relative paths are resolved from the repository root.
MEMORA_DATABASE_PATH=memora.db
MEMORA_CHROMA_PATH=chroma_db

# Set true to expose /test-* and /evaluate-* development endpoints.
MEMORA_ENABLE_DEV_ROUTES=false
MEMORA_MAX_TEXT_LENGTH=10000
MEMORA_DEFAULT_PAGE_SIZE=20
MEMORA_MAX_PAGE_SIZE=100
MEMORA_MAX_SEARCH_RESULTS=20

MEMORA_EMBEDDING_MODEL=all-MiniLM-L6-v2
MEMORA_EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base
MEMORA_NER_MODEL=dslim/bert-base-NER
